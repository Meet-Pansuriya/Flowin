---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { siteRanges } from '../../data/siteRanges';
---
<BaseLayout title="Catalog | Flowin" description="Open the official Flowin Catalog. Jump to uPVC, cPVC, SWR or agriculture catalogue sections."><SiteHeader /><main id="main-content" tabindex="-1"><section class="wrap simple-hero"><p class="kicker">The Flowin range, ready to share</p><h1>Catalog</h1><p>Keep the Flowin range at hand at the counter, on site or when planning a purchase. Download pipes, fitting families, sizes, packing details in one catalogue.</p></section><section class="wrap catalogue-content"><div class="catalogue-cover"><img src="/images/catalogue-october/cover.webp" alt="Flowin product assortment" width="500" height="500" /><h2>Flowin pipes<br />&amp; fittings</h2><p>Catalog</p><a class="solid-btn" href="/catalogue/flowin-price-list-october-2026.pdf" target="_blank" rel="noopener">Open complete catalogue ↗</a><a class="footer-catalogue" href="/catalogue/flowin-price-list-october-2026.pdf" download>Download PDF</a></div><div class="catalogue-index"><h2>Find the range your order needs.</h2>{siteRanges.map(r => <a href={`/catalogue/flowin-price-list-october-2026.pdf#page=${r.sourcePage}`} target="_blank" rel="noopener"><span><strong>{r.name}</strong><small>Open the catalogue section at PDF page {r.sourcePage}</small></span><span aria-hidden="true">↗</span></a>)}<p>Use the catalogue to plan your requirement. Confirm product availability and order details with your dealer.</p><a class="text-link" href="/products/">Explore Flowin products</a></div></section></main><SiteFooter /></BaseLayout>
