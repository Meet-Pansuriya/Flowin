---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="About Flowin | Flowin Pipes & Fittings" description="Learn about Flowin Pipe Pvt. Ltd., established in 2013, and its uPVC, cPVC, SWR and agriculture pipes and fittings.">
  <SiteHeader />
  <main>
    <section class="wrap about-hero" aria-labelledby="about-page-title">
      <div>
        <span class="eyebrow">About us</span>
        <h1 id="about-page-title">Built around the way water moves.</h1>
      </div>
      <div class="about-hero-side">
        <span class="about-year">2013<span>Established</span></span>
        <p>Flowin Pipe Pvt. Ltd. manufactures pipes and fittings for plumbing, drainage, agriculture and water-management applications.</p>
      </div>
    </section>

    <section class="about-story" aria-labelledby="story-title">
      <div class="wrap about-story-inner">
        <div><span class="eyebrow">Who we are</span><h2 id="story-title">One brand.<br />Many applications.</h2></div>
        <div class="about-story-copy">
          <p>Established in 2013, Flowin Pipe Pvt. Ltd. is a manufacturer of uPVC, cPVC, agriculture and SWR pipes and fittings.</p>
          <p>Our 2026 catalogue brings these systems together for residential, commercial, agricultural and industrial applications. It presents the available product families, configurations, sizes and printed rates in one place.</p>
          <a class="text-link" href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">Explore the 2026 catalogue <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="wrap about-systems" aria-labelledby="systems-title">
      <div class="about-systems-head"><span class="eyebrow">What we make</span><h2 id="systems-title">A range for each job.</h2><p>Start with the application, then explore the matching pipes and fittings.</p></div>
      <div class="about-system-grid">
        <a href="/products/upvc/"><span>01 / PLUMBING</span><strong>uPVC</strong><small>Explore range ↗</small></a>
        <a href="/products/cpvc/"><span>02 / PLUMBING</span><strong>cPVC</strong><small>Explore range ↗</small></a>
        <a href="/products/swr/"><span>03 / DRAINAGE</span><strong>SWR</strong><small>Explore range ↗</small></a>
        <a href="/products/agriculture/"><span>04 / AGRICULTURE</span><strong>Agri</strong><small>Explore range ↗</small></a>
      </div>
    </section>

    <section class="about-vision" aria-labelledby="vision-title">
      <div class="wrap about-vision-inner">
        <span class="eyebrow">Our vision</span>
        <h2 id="vision-title">Strong products.<br />Dependable quality.<br />Lasting value.</h2>
        <p>Our stated vision is to become a trusted and progressive name in the piping industry by delivering these to customers and partners.</p>
      </div>
    </section>

    <section class="wrap about-next" aria-labelledby="next-title">
      <div><span class="eyebrow">Explore Flowin</span><h2 id="next-title">Find the right system for your project.</h2></div>
      <div><p>Browse the product ranges or check the full 2026 price list for detailed variants and rates.</p><a class="solid-btn" href="/#products">Explore products <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
