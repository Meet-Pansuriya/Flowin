---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SwrFittingRateTable from '../../../components/SwrFittingRateTable.astro';
import { swrRingFitBends } from '../../../data/swrRingFitBends';

const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=11';
---

<BaseLayout title="SWR ring-fit bends | Flowin Pipes & Fittings" description="Flowin SWR ring-fit 87.5-degree bend and door-bend sizes, box packing and rates from the 2026 catalogue.">
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/swr/">SWR drainage</a><span aria-hidden="true">/</span><span aria-current="page">Ring-fit bends</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">SWR drainage / ring fit</span><h1 id="family-title">Ring-fit<br />bends.</h1><p class="product-lead">Find the bend variant specified for your ring-fit SWR system. Flowin offers 87.5-degree bends and door bends in 75 mm and 110 mm sizes.</p><p class="product-standard">Product system: <strong>SWR FITTING (RING FIT)</strong></p><div class="product-actions"><a class="request-link" href="/enquiry/?range=swr&amp;family=Ring-fit%20bends">Build your order list</a><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">Open catalogue <span aria-hidden="true">↗</span></a></div></div>
      <figure class="product-visual"><img src="/images/plumbing-sergei-starostin.jpg" alt="Generic application photo; catalogue tables identify the products." width="900" height="600" /></figure>
    </section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Sizes, box packing<br />and rates.</h2><p>Choose the size you need, check packing and add your order quantity.</p></div><div class="variant-grid">{swrRingFitBends.map((variant, index) => <SwrFittingRateTable variant={variant} number={String(index + 1).padStart(2, '0')} />)}</div><div class="source-band"><a href={catalogueUrl} target="_blank" rel="noopener">Open catalogue ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">More ring-fit products</span><h2 id="family-outro-title">Need pipes or<br />other fittings?</h2></div><div><p>Browse ring-fit pipes, bends, tees, couplers and accessories in the SWR range. Bring the pipes and fittings for your order together in one list.</p><a class="solid-btn" href="/products/swr/ring-fit-pipes/">View ring-fit pipes <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
