---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SwrFittingRateTable from '../../../components/SwrFittingRateTable.astro';
import { swrSelfFitAccessories, pvcSolvent } from '../../../data/swrSelfFitAccessories';
const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=13';
---
<BaseLayout title="SWR self-fit accessories & solvent | Flowin Pipes & Fittings" description="Flowin SWR self-fit accessories, traps and PVC solvent packing and rates from page 13 of the 2026 catalogue.">
  <SiteHeader /><main>
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/swr/">SWR drainage</a><span aria-hidden="true">/</span><span aria-current="page">Self-fit accessories</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">SWR drainage / self fit</span><h1 id="family-title">Self-fit<br />accessories.</h1><p class="product-lead">Cleansing pipes, caps, traps and more, together with the separately printed PVC solvent range.</p><p class="product-standard">Catalogue section: <strong>SWR FITTING (SELF FIT)</strong>, continued on page 13. Unprinted Vent Cowl packing and rate cells remain blank.</p><div class="product-actions"><a class="solid-btn" href="#sizes">View tables <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">See catalogue page 13 <span aria-hidden="true">↗</span></a></div></div>
      <figure class="product-visual"><svg viewBox="0 0 500 500" role="img" aria-label="Illustrative line diagram of drainage fittings and solvent container"><path d="M85 95h95v110h55v95h-55v110H85V300H30v-95h55zM310 115h100v220H310zM325 85h70v30h-70z" fill="#dde0d9" stroke="#777e78" stroke-width="4"/><ellipse cx="132" cy="95" rx="47" ry="15" fill="#c7ccc6" stroke="#777e78" stroke-width="4"/><ellipse cx="132" cy="95" rx="33" ry="8" fill="#636963"/><path d="M315 160h90M315 285h90M45 252h39M181 252h50" stroke="#c64d18" stroke-width="5"/></svg><figcaption>Illustrative diagram; not product photography.</figcaption></figure>
    </section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Accessories and<br />PVC solvent.</h2><p>Six fitting tables and one solvent table from page 13. Rates are reproduced without assuming a currency.</p></div><div class="variant-grid">{swrSelfFitAccessories.map((variant, index) => <SwrFittingRateTable variant={variant} number={String(index + 1).padStart(2, '0')} system="self-fit" sourcePage={13} />)}
      <section class="variant-section" id="pvc-solvent" aria-labelledby="solvent-title"><div class="variant-heading"><span class="variant-index">07 / PVC SOLVENT</span><h2 id="solvent-title">PVC solvent</h2><p>Container quantity, printed packing, master packing and printed rate.</p></div><p class="table-hint">Swipe to see all columns <span aria-hidden="true">→</span></p><div class="table-scroll" role="region" aria-label="PVC solvent packing and rate table" tabindex="0"><table><caption class="sr-only">PVC solvent packing and rate — Flowin 2026 catalogue page 13</caption><thead><tr><th scope="col">Quantity</th><th scope="col">Packing</th><th scope="col">Master packing</th><th scope="col">Rate / pc.</th></tr></thead><tbody>{pvcSolvent.map((row) => <tr><th scope="row">{row.quantity}</th><td>{row.packing}</td><td>{row.masterPacking}</td><td>{row.rate}</td></tr>)}</tbody></table></div></section>
    </div><div class="source-band"><p>Source: Flowin Price list 2026, PDF page 13. Blank cells are blank in print; consult the original for current commercial terms.</p><a href={catalogueUrl} target="_blank" rel="noopener">Open original tables ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Explore SWR</span><h2 id="family-outro-title">Browse the full<br />drainage range.</h2></div><div><p>Compare ring-fit and self-fit pipes and fittings from their separate catalogue sections.</p><a class="solid-btn" href="/products/swr/">View SWR range <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
