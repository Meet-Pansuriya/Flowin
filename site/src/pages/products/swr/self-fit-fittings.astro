---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SwrFittingRateTable from '../../../components/SwrFittingRateTable.astro';
import { swrSelfFitCoreFittings } from '../../../data/swrSelfFitCoreFittings';
const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=12';
---
<BaseLayout title="SWR self-fit fittings | Flowin Pipes & Fittings" description="Flowin SWR self-fit bend, tee, coupler, trap and reducer sizes, box packing and rates from the 2026 catalogue.">
  <SiteHeader /><main>
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/swr/">SWR drainage</a><span aria-hidden="true">/</span><span aria-current="page">Self-fit fittings</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">SWR drainage / self fit</span><h1 id="family-title">Self-fit<br />fittings.</h1><p class="product-lead">Browse Flowin’s core self-fit bends, tees, couplers, traps and reducers, with source-checked box packing and per-piece rates.</p><p class="product-standard">Catalogue section: <strong>SWR FITTING (SELF FIT)</strong>. Every printed table on page 12 remains separate for clear size and packing comparisons.</p><div class="product-actions"><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">See catalogue page 12 <span aria-hidden="true">↗</span></a></div></div>
      <figure class="product-visual"><svg viewBox="0 0 500 500" role="img" aria-label="Simple line illustration of assorted self-fit drainage fittings"><defs><linearGradient id="self-fit-core" x2="1" y2="1"><stop stop-color="#fff" /><stop offset="1" stop-color="#c7c9c5" /></linearGradient></defs><path d="M95 78h90v100h83v90h-83v145H95V268H30v-90h65zM303 103h102v101h60v91h-60v103H303V295h-72v-91h72z" fill="url(#self-fit-core)" stroke="#91958f" stroke-width="3"/><ellipse cx="140" cy="78" rx="45" ry="14" fill="#d8dbd6" stroke="#91958f" stroke-width="3"/><ellipse cx="140" cy="78" rx="33" ry="8" fill="#636963"/><ellipse cx="354" cy="103" rx="51" ry="16" fill="#d8dbd6" stroke="#91958f" stroke-width="3"/><ellipse cx="354" cy="103" rx="38" ry="10" fill="#636963"/><path d="M102 85c15 10 51 10 70 0M314 110c16 11 58 11 80 0M30 223h57M405 247h60" stroke="#c64d18" stroke-width="5"/></svg><figcaption>Illustrative fitting diagram; not a product photograph.</figcaption></figure>
    </section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Fittings, box packing<br />and rates.</h2><p>All ten self-fit fitting tables from page 12 are shown separately. The PDF’s “=” decimal marks are displayed as points; no currency is inferred.</p></div><div class="variant-grid">{swrSelfFitCoreFittings.map((variant, index) => <SwrFittingRateTable variant={variant} number={String(index + 1).padStart(2, '0')} system="self-fit" sourcePage={12} />)}</div><div class="source-band"><p>Source: Flowin Price list 2026, PDF page 12. Rates are per piece and packing is per box. The original catalogue is definitive.</p><a href={catalogueUrl} target="_blank" rel="noopener">Open original tables ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">More self-fit products</span><h2 id="family-outro-title">Need caps, traps<br />or accessories?</h2></div><div><p>Continue to the source-checked page-13 accessories and PVC solvent tables.</p><a class="solid-btn" href="/products/swr/self-fit-accessories/">View self-fit accessories <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
