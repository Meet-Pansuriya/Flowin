---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SwrFittingRateTable from '../../../components/SwrFittingRateTable.astro';
import { swrRingFitRemainingFittings } from '../../../data/swrRingFitRemainingFittings';
const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=11';
---
<BaseLayout title="SWR ring-fit fittings | Flowin Pipes & Fittings" description="Flowin SWR ring-fit tee, reducer, cleansing-pipe and rubber-ring sizes, box packing and rates from the 2026 catalogue.">
  <SiteHeader /><main id="main-content" tabindex="-1">
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/swr/">SWR drainage</a><span aria-hidden="true">/</span><span aria-current="page">More ring-fit fittings</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">SWR drainage / ring fit</span><h1 id="family-title">More ring-fit<br />fittings.</h1><p class="product-lead">Browse the ring-fit tee, reducer, cleansing-pipe and rubber-ring entries from Flowin’s 2026 catalogue.</p><p class="product-standard">Catalogue section: <strong>SWR FITTING (RING FIT)</strong>. Compare the available fitting sizes below.</p><div class="product-actions"><a class="request-link" href="/enquiry/?range=swr&amp;family=More%20ring-fit%20fittings">Prepare a requirement</a><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">View catalogue <span aria-hidden="true">↗</span></a></div></div>
      <figure class="product-visual"><img src="/images/plumbing-sergei-starostin.jpg" alt="Generic application photo; catalogue tables identify the products." width="900" height="600" /></figure>
    </section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Fittings, box packing<br />and rates.</h2><p>Compare sizes, packing and rates for each fitting.</p></div><div class="variant-grid">{swrRingFitRemainingFittings.map((variant, index) => <SwrFittingRateTable variant={variant} number={String(index + 1).padStart(2, '0')} />)}</div><div class="source-band"><a href={catalogueUrl} target="_blank" rel="noopener">View catalogue ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Another SWR system</span><h2 id="family-outro-title">Need self-fit<br />instead?</h2></div><div><p>Self-fit pipes are available separately. Its fitting catalogue pages remain the next review batch.</p><a class="solid-btn" href="/products/swr/self-fit-pipes/">View self-fit pipes <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
