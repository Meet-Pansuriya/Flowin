---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import CpvcPipeRateTable from '../../../components/CpvcPipeRateTable.astro';
import { cpvcNonIsiPipes, cpvcIsiPipes } from '../../../data/cpvcPipes';

const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=6';
const cpvcSdrPipes = [...cpvcNonIsiPipes, ...cpvcIsiPipes];
---

<BaseLayout title="cPVC Pipes | Flowin Pipes & Fittings" description="Explore Flowin cPVC 3 m and 5 m NON ISI- and ISI-labelled pipe sizes, bag packing and SDR-11/SDR-13.5 rates from the 2026 catalogue.">
  <SiteHeader />
  <main>
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/cpvc/">cPVC plumbing</a><span aria-hidden="true">/</span><span aria-current="page">Pipes</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title">
      <div class="product-hero-copy">
        <span class="eyebrow">cPVC plumbing / pipes</span>
        <h1 id="family-title">cPVC<br />pipes.</h1>
        <p class="product-lead">Explore the printed NON ISI- and ISI-labelled 3 m and 5 m pipe groups, with size, bag packing and separate SDR-11 and SDR-13.5 rates.</p>
        <p class="product-standard">This page covers the catalogue's <strong>ASTM 2846-labelled SDR groups</strong>. The larger ASTM F-441-labelled schedule group remains in the PDF.</p>
        <div class="product-actions"><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">See catalogue page 6 <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="product-visual"><img src="/images/cpvc-pipes-legacy.jpg" alt="Flowin's earlier cPVC pipe product image" width="300" height="300" /><figcaption>Product image from Flowin's earlier website.</figcaption></figure>
    </section>

    <section class="product-data" id="sizes" aria-labelledby="sizes-title">
      <div class="wrap">
        <div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Lengths, sizes<br />and SDR rates.</h2><p>Four page-6 SDR tables are shown: NON ISI-labelled and ISI-labelled groups in both lengths. These printed labels are catalogue identifiers, not independently verified certification claims.</p></div>
        <div class="variant-grid">
          {cpvcSdrPipes.map((group, index) => <CpvcPipeRateTable group={group} number={String(index + 1).padStart(2, '0')} />)}
        </div>
        <div class="source-band"><p>Source: Flowin Price list 2026, PDF page 6. Rates are per piece with printed precision retained; no currency symbol has been inferred. The PDF is definitive.</p><a href={catalogueUrl} target="_blank" rel="noopener">Open original tables ↗</a></div>
      </div>
    </section>

    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">More pipe groups</span><h2 id="family-outro-title">See the complete<br />cPVC range.</h2></div><div><p>The 2026 catalogue also has larger ASTM F-441-labelled SCH-40/SCH-80 pipe tables. Those are not transcribed on this page yet.</p><a class="solid-btn" href={catalogueUrl} target="_blank" rel="noopener">View all cPVC pipes <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
