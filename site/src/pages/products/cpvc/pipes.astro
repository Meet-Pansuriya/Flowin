---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import CpvcPipeRateTable from '../../../components/CpvcPipeRateTable.astro';
import PipeRateTable from '../../../components/PipeRateTable.astro';
import { cpvcNonIsiPipes, cpvcIsiPipes, cpvcSchedulePipes } from '../../../data/cpvcPipes';

const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=7';
const cpvcSdrPipes = [...cpvcNonIsiPipes, ...cpvcIsiPipes];
---

<BaseLayout title="cPVC Pipes | Flowin Pipes & Fittings" description="Explore Flowin cPVC 3 m and 5 m pipe sizes, packing and printed SDR-11/SDR-13.5 or SCH-40/SCH-80 rates from the 2026 catalogue.">
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/cpvc/">cPVC plumbing</a><span aria-hidden="true">/</span><span aria-current="page">Pipes</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title">
      <div class="product-hero-copy">
        <span class="eyebrow">cPVC plumbing / pipes</span>
        <h1 id="family-title">cPVC<br />pipes.</h1>
        <p class="product-lead">Choose the cPVC pipe group your project calls for. Explore Flowin SDR and schedule options in 3 m and 5 m lengths, then put the right sizes on your order list.</p>
        <p class="product-standard">Pipe options: <strong>NON ISI and ISI ASTM 2846-labelled SDR pipes, plus ASTM F-441-labelled schedule pipes.</strong></p>
        <div class="product-actions"><a class="request-link" href="/enquiry/?range=cpvc&amp;family=cPVC%20pipes">Build your order list</a><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">Open catalogue <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="product-visual"><img src="/images/cpvc-pipes-legacy.jpg" alt="Flowin's earlier cPVC pipe product image" width="300" height="300" /></figure>
    </section>

    <section class="product-data" id="sizes" aria-labelledby="sizes-title">
      <div class="wrap">
        <div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Lengths, sizes<br />and rates.</h2><p>Find the length and size specified for your project, then plan your quantity.</p></div>
        <div class="pipe-group-intro"><span class="eyebrow">01 / SDR pipe groups</span><p>NON ISI-labelled and ISI-labelled, each in 3 m and 5 m lengths.</p></div>
        <div class="variant-grid">
          {cpvcSdrPipes.map((group, index) => <CpvcPipeRateTable group={group} number={String(index + 1).padStart(2, '0')} />)}
        </div>
        <div class="pipe-group-intro pipe-group-intro-spaced"><span class="eyebrow">02 / Schedule pipe groups</span><p>ASTM F-441-labelled larger sizes, with SCH-40 and SCH-80 rate columns.</p></div>
        <div class="variant-grid">
          {cpvcSchedulePipes.map((group, index) => <PipeRateTable group={group} number={String(index + 5).padStart(2, '0')} sourcePage={7} />)}
        </div>
        <div class="source-band"><a href={catalogueUrl} target="_blank" rel="noopener">Open catalogue ↗</a></div>
      </div>
    </section>

    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Next connection</span><h2 id="family-outro-title">Explore the fittings.</h2></div><div><p>Browse cPVC fittings or open the catalogue for the complete range.</p><a class="solid-btn" href="/products/cpvc/">Explore cPVC range <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
