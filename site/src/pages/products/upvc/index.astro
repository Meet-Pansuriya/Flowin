---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
---

<BaseLayout title="uPVC plumbing | Flowin Pipes & Fittings" description="Browse Flowin uPVC plumbing pipes and fittings, including detailed pipe, elbow, tee and reducing tee families and the full 2026 catalogue.">
  <SiteHeader />
  <main>
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">uPVC plumbing</span></div>
    <section class="wrap range-hero" aria-labelledby="range-title">
      <div><span class="eyebrow">Product system / 01</span><h1 id="range-title">uPVC<br />plumbing.</h1></div>
      <div class="range-hero-side"><p>Explore Flowin uPVC plumbing pipes and fittings. We are adding detailed family pages in verified slices, with the complete range always available in the 2026 catalogue.</p><a class="text-link" href="/catalogue/flowin-price-list-2026.pdf#page=3" target="_blank" rel="noopener">View uPVC catalogue pages <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="wrap range-family-section" aria-labelledby="families-title"><div class="range-section-heading"><span class="eyebrow">Explore uPVC</span><h2 id="families-title">Find the right<br />component.</h2><p>These family pages contain verified size, packing and rate tables from the supplied catalogue.</p></div>
      <div class="family-card-grid">
        <a class="family-card" href="/products/upvc/pipes/"><span class="family-number">01 / PIPES</span><div class="family-card-symbol" aria-hidden="true"><svg viewBox="0 0 120 120"><path d="M31 15v90M53 15v90M70 15v90M92 15v90M27 15h30M27 105h30M66 15h30M66 105h30" /></svg></div><div><h3>Pipes</h3><p>3 m and 6 m, with SCH-40 and SCH-80 rate columns.</p><span class="family-arrow" aria-hidden="true">↗</span></div></a>
        <a class="family-card" href="/products/upvc/elbows/"><span class="family-number">02 / FITTINGS</span><div class="family-card-symbol" aria-hidden="true"><svg viewBox="0 0 120 120"><path d="M25 84V43c0-12 10-22 22-22h26c12 0 22 10 22 22v41M18 86h31m22 0h31M25 43h70M38 43v40m44-40v40" /></svg></div><div><h3>Elbows</h3><p>Elbow and 45° elbow size tables.</p><span class="family-arrow" aria-hidden="true">↗</span></div></a>
        <a class="family-card family-card-featured" href="/products/upvc/tees/"><span class="family-number">03 / FITTINGS</span><div class="family-card-symbol" aria-hidden="true"><svg viewBox="0 0 120 120"><path d="M49 20h22v80H49zM20 49h80v22H20zM49 49h22v22H49z" /></svg></div><div><h3>Tees</h3><p>Tee and cross-tee size tables.</p><span class="family-arrow" aria-hidden="true">↗</span></div></a>
        <a class="family-card" href="/products/upvc/reducing-tees/"><span class="family-number">04 / FITTINGS</span><div class="family-card-symbol" aria-hidden="true"><svg viewBox="0 0 120 120"><path d="M43 20h34v80H43zM20 44h23v25H20zM77 49h23v16H77zM43 49h34v16H43z" /></svg></div><div><h3>Reducing tees</h3><p>Paired sizes and page-4 catalogue details.</p><span class="family-arrow" aria-hidden="true">↗</span></div></a>
      </div>
    </section>

    <section class="range-catalogue-band"><div class="wrap range-catalogue-inner"><div><span class="eyebrow">Complete range</span><h2>More fittings<br />are in the catalogue.</h2></div><div><p>The price list also covers uPVC reducers, couplers, unions, valves, adaptors and related items. Their web pages are still being verified.</p><a class="solid-btn" href="/catalogue/flowin-price-list-2026.pdf#page=3" target="_blank" rel="noopener">Browse 2026 catalogue <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
