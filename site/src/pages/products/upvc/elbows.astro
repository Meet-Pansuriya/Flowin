---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import RateTable from '../../../components/RateTable.astro';
import { upvcElbows } from '../../../data/productFamilies';

const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=2';
---

<BaseLayout title="uPVC elbows | Flowin Pipes & Fittings" description="Explore Flowin uPVC plumbing elbow sizes, bag packing, inner packing and 2026 catalogue rates.">
  <SiteHeader />
  <main>
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/#products">uPVC plumbing</a><span aria-hidden="true">/</span><span aria-current="page">Elbows</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title">
      <div class="product-hero-copy">
        <span class="eyebrow">uPVC plumbing / fittings</span>
        <h1 id="family-title">uPVC<br />elbows.</h1>
        <p class="product-lead">Two elbow styles, with sizes, packing and rates taken from Flowin's 2026 catalogue.</p>
        <p class="product-standard">Catalogue section: <strong>ASTM D-2467 SCH-80</strong></p>
        <div class="product-actions"><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">See catalogue page 2 <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="product-visual"><img src="/images/upvc-elbow-legacy.jpg" alt="Flowin's legacy image of a white uPVC elbow fitting" width="300" height="300" /><figcaption>Product image from Flowin's earlier website.</figcaption></figure>
    </section>

    <section class="product-data" id="sizes" aria-labelledby="sizes-title">
      <div class="wrap">
        <div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">The sizes behind<br />the system.</h2><p>Rates are per piece as listed in the supplied 2026 price list. The original catalogue remains the definitive reference.</p></div>
        <div class="variant-grid">
          {upvcElbows.map((variant, index) => <RateTable variant={variant} number={String(index + 1).padStart(2, '0')} />)}
        </div>
        <div class="source-band"><p>Source: Flowin Price list 2026, PDF page 2. No currency symbol is added because the supplied table does not specify one.</p><a href={catalogueUrl} target="_blank" rel="noopener">Open original table ↗</a></div>
      </div>
    </section>

    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Next connection</span><h2 id="family-outro-title">Need another fitting?</h2></div><div><p>More detailed families are being prepared. Browse the full uPVC range in the official catalogue; email and phone details will be added here when confirmed.</p><a class="solid-btn" href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">Download full catalogue <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
