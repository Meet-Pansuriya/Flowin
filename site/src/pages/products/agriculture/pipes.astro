---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import AgriculturePipeRateTable from '../../../components/AgriculturePipeRateTable.astro';
import { agriculturePipes } from '../../../data/agriculture';
const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=14';
---
<BaseLayout title="Agriculture pipes | Flowin Pipes & Fittings" description="Flowin agriculture pipe sizes and 3 m and 6 m rates from the 2026 catalogue.">
  <SiteHeader /><main id="main-content" tabindex="-1"><div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/agriculture/">Agriculture</a><span aria-hidden="true">/</span><span aria-current="page">Pipes</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">Agriculture / pipes</span><h1 id="family-title">Agriculture<br />pipes.</h1><p class="product-lead">Plan your agricultural pipe order around the required length, size and pressure or class group. Explore Flowin 3 m and 6 m options for your product list.</p><p class="product-standard">Compare the pressure and class groups below.</p><div class="product-actions"><a class="request-link" href="/enquiry/?range=agriculture&amp;family=Agriculture%20pipes">Build your order list</a><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">Open catalogue <span aria-hidden="true">↗</span></a></div></div><figure class="product-visual"><img src="/images/irrigation-daniel-kawed.jpg" alt="Generic application photo; catalogue tables identify the products." width="900" height="600" /></figure></section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Length, pressure<br />and rates.</h2><p>Find the length and size specified for your project, then plan your quantity.</p></div><div class="variant-grid">{agriculturePipes.map((group, index) => <AgriculturePipeRateTable group={group} number={String(index + 1).padStart(2, '0')} />)}</div><div class="source-band"><a href={catalogueUrl} target="_blank" rel="noopener">Open catalogue ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Complete the system</span><h2 id="family-outro-title">Need agriculture<br />fittings?</h2></div><div><p>Compare six fitting families with box packing and per-piece rates.</p><a class="solid-btn" href="/products/agriculture/fittings/">View fittings <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
