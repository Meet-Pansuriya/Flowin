---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import AgriculturePipeRateTable from '../../../components/AgriculturePipeRateTable.astro';
import { agriculturePipes } from '../../../data/agriculture';
const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=14';
---
<BaseLayout title="Agriculture pipes | Flowin Pipes & Fittings" description="Flowin agriculture pipe sizes and 3 m and 6 m rates from the 2026 catalogue.">
  <SiteHeader /><main><div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/agriculture/">Agriculture</a><span aria-hidden="true">/</span><span aria-current="page">Pipes</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">Agriculture / pipes</span><h1 id="family-title">Agriculture<br />pipes.</h1><p class="product-lead">Four printed groups: 3 m and 6 m lengths in the standard and ISI-labelled catalogue sections.</p><p class="product-standard">Pressure and class labels follow the catalogue. An empty cell means no rate was printed for that combination.</p><div class="product-actions"><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">See catalogue page 14 <span aria-hidden="true">↗</span></a></div></div><figure class="product-visual"><svg viewBox="0 0 500 500" role="img" aria-label="Illustrative diagram of agriculture pipe lengths"><path d="M88 62v370M165 62v370M290 62v370M367 62v370M75 62h103M75 432h103M277 62h103M277 432h103" fill="none" stroke="#898f89" stroke-width="10"/><path d="M88 120h77M290 120h77M88 375h77M290 375h77" stroke="#c64d18" stroke-width="5"/></svg><figcaption>Illustrative pipe diagram; not product photography.</figcaption></figure></section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Length, pressure<br />and rates.</h2><p>All four pipe tables and their 26 size rows from page 14. No currency is inferred.</p></div><div class="variant-grid">{agriculturePipes.map((group, index) => <AgriculturePipeRateTable group={group} number={String(index + 1).padStart(2, '0')} />)}</div><div class="source-band"><p>Source: Flowin Price list 2026, PDF page 14. “ISI” is a printed catalogue label, not an independently verified certification claim.</p><a href={catalogueUrl} target="_blank" rel="noopener">Open original tables ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Complete the system</span><h2 id="family-outro-title">Need agriculture<br />fittings?</h2></div><div><p>Compare six fitting families with box packing and per-piece rates.</p><a class="solid-btn" href="/products/agriculture/fittings/">View fittings <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
