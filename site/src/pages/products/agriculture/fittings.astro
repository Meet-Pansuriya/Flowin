---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import AgricultureFittingRateTable from '../../../components/AgricultureFittingRateTable.astro';
import { agricultureFittings } from '../../../data/agriculture';
const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=14';
---
<BaseLayout title="Agriculture fittings | Flowin Pipes & Fittings" description="Flowin agriculture elbows, tees, couplers, back flow and RRC couplers, with box packing and 2026 rates.">
  <SiteHeader /><main><div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/agriculture/">Agriculture</a><span aria-hidden="true">/</span><span aria-current="page">Fittings</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">Agriculture / fittings</span><h1 id="family-title">Agriculture<br />fittings.</h1><p class="product-lead">Elbows, tees, couplers, back flow and 4 KG RRC couplers, each kept in its printed table.</p><p class="product-standard">Six fitting groups show size, packing in box and rate per piece from catalogue page 14.</p><div class="product-actions"><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">See catalogue page 14 <span aria-hidden="true">↗</span></a></div></div><figure class="product-visual"><svg viewBox="0 0 500 500" role="img" aria-label="Illustrative diagram of agriculture fittings"><path d="M90 80h90v105h82v95h-82v130H90V280H25v-95h65zM305 90h96v120h55v95h-55v105h-96V305h-60v-95h60z" fill="#d9ddd7" stroke="#838b83" stroke-width="4"/><ellipse cx="135" cy="80" rx="45" ry="13" fill="#c9d0c8" stroke="#838b83" stroke-width="3"/><ellipse cx="353" cy="90" rx="48" ry="14" fill="#c9d0c8" stroke="#838b83" stroke-width="3"/><path d="M25 232h65M180 232h82M245 257h60M401 257h55" stroke="#c64d18" stroke-width="5"/></svg><figcaption>Illustrative fitting diagram; not product photography.</figcaption></figure></section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Sizes, packing<br />and rates.</h2><p>All 24 fitting rows across six tables on page 14. The PDF’s “=” decimal marks are displayed as points; no currency is inferred.</p></div><div class="variant-grid">{agricultureFittings.map((variant, index) => <AgricultureFittingRateTable variant={variant} number={String(index + 1).padStart(2, '0')} />)}</div><div class="source-band"><p>Source: Flowin Price list 2026, PDF page 14. Packing is per box and rates are per piece; consult the original for current commercial terms.</p><a href={catalogueUrl} target="_blank" rel="noopener">Open original tables ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Complete the system</span><h2 id="family-outro-title">Need agriculture<br />pipes?</h2></div><div><p>Compare 3 m and 6 m pressure and class rate columns.</p><a class="solid-btn" href="/products/agriculture/pipes/">View pipes <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
