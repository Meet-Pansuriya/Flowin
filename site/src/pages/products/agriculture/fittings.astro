---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import AgricultureFittingRateTable from '../../../components/AgricultureFittingRateTable.astro';
import { agricultureFittings } from '../../../data/agriculture';
const catalogueUrl = '/catalogue/flowin-price-list-2026.pdf#page=14';
---
<BaseLayout title="Agriculture fittings | Flowin Pipes & Fittings" description="Flowin agriculture elbows, tees, couplers, back flow and RRC couplers, with box packing and 2026 rates.">
  <SiteHeader /><main id="main-content" tabindex="-1"><div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/agriculture/">Agriculture</a><span aria-hidden="true">/</span><span aria-current="page">Fittings</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title"><div class="product-hero-copy"><span class="eyebrow">Agriculture / fittings</span><h1 id="family-title">Agriculture<br />fittings.</h1><p class="product-lead">Elbows, tees, couplers, back flow and 4 KG RRC couplers, with size, packing and rate details.</p><p class="product-standard">Six fitting groups show size, packing in box and rate per piece from catalogue page 14.</p><div class="product-actions"><a class="request-link" href="/enquiry/?range=agriculture&amp;family=Agriculture%20fittings">Prepare a requirement</a><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">View catalogue <span aria-hidden="true">↗</span></a></div></div><figure class="product-visual"><img src="/images/irrigation-daniel-kawed.jpg" alt="Generic application photo; catalogue tables identify the products." width="900" height="600" /></figure></section>
    <section class="product-data" id="sizes" aria-labelledby="sizes-title"><div class="wrap"><div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Sizes, packing<br />and rates.</h2><p>Compare sizes, packing and rates for each fitting.</p></div><div class="variant-grid">{agricultureFittings.map((variant, index) => <AgricultureFittingRateTable variant={variant} number={String(index + 1).padStart(2, '0')} />)}</div><div class="source-band"><a href={catalogueUrl} target="_blank" rel="noopener">View catalogue ↗</a></div></div></section>
    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Complete the system</span><h2 id="family-outro-title">Need agriculture<br />pipes?</h2></div><div><p>Compare 3 m and 6 m pressure and class rate columns.</p><a class="solid-btn" href="/products/agriculture/pipes/">View pipes <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter />
</BaseLayout>
