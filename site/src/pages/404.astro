---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Page not found | Flowin" description="Find Flowin product ranges, catalogue details and enquiry tools.">
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <section class="wrap simple-hero">
      <p class="kicker">Page not found</p>
      <h1>Find your way<br />back to the range.</h1>
      <p>This page is unavailable. Browse Flowin pipes and fittings to find the product family you need.</p>
      <div class="product-actions"><a class="solid-btn" href="/products/">Browse products</a><a class="text-link" href="/">Back to home</a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
