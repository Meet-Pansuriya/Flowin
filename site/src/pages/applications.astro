---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/applications.css';
const applications = [
 {id:'plumbing',title:'For the homes you help build.',alt:'Illustrative scene of an Indian plumber checking cream plastic pipework in a bright residential utility area',text:'From a new bathroom to a complete plumbing requirement, bring pipe lengths and fittings together in one Flowin order. Explore uPVC and cPVC, then select the material and sizes specified for the job.',details:['uPVC and cPVC ranges','Pipes, elbows, tees and couplers'],links:[{name:'Explore uPVC',href:'/products/upvc/'},{name:'Explore cPVC',href:'/products/cpvc/'}],tip:'For your list: material, size, pipe length and quantity.'},
 {id:'drainage',title:'Bring the drainage system together.',alt:'Illustrative scene of an Indian professional inspecting grey drainage pipework beside a residential building',text:'Plan the SWR pipes, bends, tees and accessories your installation calls for. Flowin keeps Ring-fit and Self-fit ranges separate, so you can find the matching product families for your chosen joint system.',details:['Ring-fit and Self-fit systems','Pipes, bends, tees and accessories'],links:[{name:'Explore Ring-fit',href:'/products/swr/#ring-fit'},{name:'Explore Self-fit',href:'/products/swr/#self-fit'}],tip:'For your list: joint system, diameter, length and fitting type.'},
 {id:'agriculture',title:'For the work beyond the building.',alt:'Illustrative scene of an Indian farmer checking agricultural piping beside green cultivated fields',text:'Put agricultural pipe lengths and fittings on the same requirement list. Browse the Flowin agriculture range by the size and pressure group specified for your work, then add the quantities you need.',details:['Agricultural pipes and fittings','Lengths, sizes and pressure groups'],links:[{name:'Explore agriculture',href:'/products/agriculture/'},{name:'Find pipe options',href:'/products/agriculture/pipes/'}],tip:'For your list: diameter, pressure group, length and quantity.'}
];
---
<BaseLayout title="Applications | Flowin pipes & fittings" description="Find Flowin pipes and fittings for residential plumbing, SWR drainage and agricultural requirements. Choose your range and prepare a clear order list.">
<SiteHeader />
<main id="main-content" tabindex="-1" class="applications-page">
 <section class="wrap applications-intro"><h1>Where the work happens.<br /><span>There’s a Flowin range.</span></h1><div><p>At the building site, behind the bathroom wall or out in the field—start with the application, then find the pipes and fittings your next order needs.</p><nav class="application-jumps" aria-label="Choose an application"><a href="#plumbing">Plumbing ↓</a><a href="#drainage">Drainage ↓</a><a href="#agriculture">Agriculture ↓</a></nav></div></section>
 <div class="wrap application-stories">{applications.map((application,index)=><section id={application.id} class:list={['application-story',{'application-story-reverse':index===1}]} aria-labelledby={`${application.id}-title`}><figure><img src={`/images/applications/${application.id}.webp`} alt={application.alt} width="1536" height="1024" loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'} /></figure><div class="application-story-copy"><h2 id={`${application.id}-title`}>{application.title}</h2><p>{application.text}</p><ul class="application-facts">{application.details.map(detail=><li>{detail}</li>)}</ul><div class="application-range-links">{application.links.map((link,i)=><a class={i===0?'solid-btn':'text-link'} href={link.href}>{link.name} <span aria-hidden="true">↗</span></a>)}</div><p class="application-order-tip">{application.tip}</p></div></section>)}</div>
 <section class="application-order-section"><div class="wrap application-order-inner"><div><h2>A clearer list.<br />An easier conversation.</h2><p>Keep the product, size and quantity together for each item. Add your installation requirements, then share the list with your dealer to confirm availability.</p><a class="solid-btn" href="/enquiry/">Build your order list ↗</a></div><ol><li><h3>Choose the system</h3><p>Start with the material and joint type specified for your installation.</p></li><li><h3>Add the product details</h3><p>Include diameter, length, variant and the quantity you need.</p></li><li><h3>Check with your dealer</h3><p>Use your list to discuss availability and complete the order details.</p></li></ol></div></section>
</main><SiteFooter />
</BaseLayout>
