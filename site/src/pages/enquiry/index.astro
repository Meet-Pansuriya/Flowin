---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { siteRanges } from '../../data/siteRanges';
---
<BaseLayout title="Prepare a product enquiry | Flowin" description="Prepare a Flowin pipes and fittings requirement with product family, size and quantity. Copy or download your list to share with your dealer.">
 <SiteHeader /><main id="main-content" tabindex="-1"><section class="wrap simple-hero"><p class="kicker">For your next conversation</p><h1>Keep the requirement clear.</h1><p>Add the product family, size and quantity you need. Copy or download the list to share with your dealer or existing Flowin contact.</p></section>
 <div class="wrap enquiry-layout"><form class="requirement-form" id="requirement-form"><h2>Add a product</h2><div class="form-grid"><label>Product range<select id="requirement-range" required>{siteRanges.map(r=><option value={r.name}>{r.name}</option>)}</select></label><label>Product family<input id="requirement-family" list="family-suggestions" placeholder="e.g. Elbow" maxlength="120" required /></label><datalist id="family-suggestions">{siteRanges.flatMap(r=>r.families.map(f=><option value={f.title} />))}</datalist><label>Size / variant<input id="requirement-size" placeholder="e.g. 25 mm, SCH-40" maxlength="120" required /></label><label>Quantity &amp; unit<input id="requirement-quantity" placeholder="e.g. 50 pieces" maxlength="100" required /></label><label class="form-wide">Notes <span>(optional)</span><textarea id="requirement-notes" placeholder="Include length, packing or another detail to confirm." maxlength="500"></textarea></label></div><button class="solid-btn" type="submit">Add to requirement</button><p class="enquiry-notice">Use the <a class="text-link" href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">2026 catalogue</a> to check the product reference.</p></form>
 <section class="enquiry-summary" aria-labelledby="requirement-title"><h2 id="requirement-title">Your requirement</h2><p id="requirement-empty">Your list is empty. Add a product to prepare a shareable requirement.</p><ul class="enquiry-items" id="requirement-items"></ul><div class="enquiry-actions"><button type="button" id="copy-requirement" disabled>Copy requirement</button><button type="button" id="download-requirement" disabled>Download text file</button></div><p id="requirement-status" role="status" aria-live="polite"></p><p class="enquiry-notice">This page prepares your list; it does not send an enquiry. Official phone and email details are awaiting confirmation. Prices and availability should be confirmed with your contact.</p></section></div>
 <section class="catalogue-banner"><div class="wrap"><div><h2>Still checking a size?</h2><p>Browse the product tables, or keep the complete PDF open while preparing your list.</p></div><a class="solid-btn" href="/products/">Back to product directory</a></div></section></main><SiteFooter />
</BaseLayout>
<script>
 type Requirement = {range:string;family:string;size:string;quantity:string;notes:string};
 const rows:Requirement[]=[];
 const form=document.querySelector<HTMLFormElement>('#requirement-form')!;
 const field=(id:string)=>document.getElementById(id) as HTMLInputElement;
 const list=document.querySelector<HTMLUListElement>('#requirement-items')!;
 const status=document.querySelector<HTMLElement>('#requirement-status')!;
 const copy=document.querySelector<HTMLButtonElement>('#copy-requirement')!;
 const download=document.querySelector<HTMLButtonElement>('#download-requirement')!;
 const params=new URLSearchParams(location.search); const initial=params.get('family'); if(initial) field('requirement-family').value=initial.slice(0,120);
 const rangeNames:Record<string,string>={upvc:'uPVC plumbing',cpvc:'cPVC plumbing',swr:'SWR drainage',agriculture:'Agriculture'}; const requestedRange=params.get('range'); if(requestedRange && rangeNames[requestedRange]) field('requirement-range').value=rangeNames[requestedRange];
 const text=()=>['Flowin product requirement','',...rows.map((r,i)=>`${i+1}. ${r.range} — ${r.family}\nSize / variant: ${r.size}\nQuantity: ${r.quantity}${r.notes?`\nNotes: ${r.notes}`:''}`),'','Please confirm current pricing and availability.'].join('\n\n');
 function render(){list.replaceChildren();rows.forEach((row,index)=>{const item=document.createElement('li');const content=document.createElement('div');const title=document.createElement('strong');title.textContent=`${row.range}: ${row.family}`;content.append(title);const detail=document.createElement('small');detail.textContent=`${row.size} · ${row.quantity}${row.notes?` · ${row.notes}`:''}`;content.append(detail);const remove=document.createElement('button');remove.type='button';remove.textContent='Remove';remove.setAttribute('aria-label',`Remove ${row.family} ${row.size}`);remove.addEventListener('click',()=>{rows.splice(index,1);render();status.textContent='Product removed from your requirement.';});item.append(content,remove);list.append(item);});document.getElementById('requirement-empty')!.hidden=rows.length>0;copy.disabled=download.disabled=rows.length===0;}
 form.addEventListener('submit',event=>{event.preventDefault();const row={range:field('requirement-range').value,family:field('requirement-family').value.trim(),size:field('requirement-size').value.trim(),quantity:field('requirement-quantity').value.trim(),notes:field('requirement-notes').value.trim()};if(!row.family||!row.size||!row.quantity){status.textContent='Enter a product family, size and quantity.';return;}rows.push(row);render();status.textContent=`${row.family} added. ${rows.length} ${rows.length===1?'product':'products'} in your requirement.`;field('requirement-size').value='';field('requirement-quantity').value='';field('requirement-notes').value='';field('requirement-family').focus();});
 copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(text());status.textContent='Requirement copied. Share it with your dealer or existing contact.';}catch{status.textContent='Copy is unavailable in this browser. Download the text file to share your requirement.';}});
 download.addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([text()],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='flowin-requirement.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent='Requirement downloaded as a text file.';});
</script>
