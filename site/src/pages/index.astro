---
const pageTitle = 'Flowin | Site foundation';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <style>
      :root { font-family: Arial, sans-serif; color: #20211f; background: #f8f7f4; }
      body { margin: 0; }
      main { min-height: 100vh; display: grid; place-content: center; padding: 2rem; }
      p { max-width: 38rem; line-height: 1.6; }
      .eyebrow { color: #c64a13; font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; }
    </style>
  </head>
  <body>
    <main>
      <span class="eyebrow">Flowin / foundation</span>
      <h1>Project setup is ready.</h1>
      <p>The approved design demo and verified product catalogue will be brought into this app in later, separately reviewed chunks.</p>
    </main>
  </body>
</html>
