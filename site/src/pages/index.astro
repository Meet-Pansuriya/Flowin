---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/photo-themes.css';
import { Image } from 'astro:assets';
import hero from '../../public/images/flowin-showroom-hero.png';


const catalogue = '/catalogue/flowin-price-list-2026.pdf';
const ranges = [
  {name:'uPVC plumbing',note:'Schedules, sizes and fittings',href:'/products/upvc/',photo:'/images/upvc-elbow-legacy.jpg',caption:'Flowin product photo',body:'Pipes, elbows, tees and couplers for the uPVC plumbing items on your order.'},
  {name:'cPVC plumbing',note:'SDR and schedule variants',href:'/products/cpvc/',photo:'/images/cpvc-elbow-legacy.jpg',caption:'Flowin product photo',body:'Bring cPVC pipe options and fitting families into one product list for your next project.'},
  {name:'SWR drainage',note:'Ring-fit and self-fit ranges',href:'/products/swr/',photo:'/images/plumbing-sergei-starostin.jpg',caption:'Generic plumbing application',body:'Choose your SWR joint system, then bring its pipes, bends, tees and accessories together.'},
  {name:'Agriculture',note:'Pipes and fitting families',href:'/products/agriculture/',photo:'/images/irrigation-daniel-kawed.jpg',caption:'Generic agricultural application',body:'Find agricultural pipe lengths, pressure groups and fittings for the requirement you need to fulfil.'},
];
---
<BaseLayout title="Flowin Pipes & Fittings | uPVC, cPVC, SWR & Agriculture" description="Explore Flowin uPVC, cPVC, SWR and agricultural pipes and fittings. Compare sizes, packing and catalogue rates, and prepare product requirements for dealers and plumbers in India.">
  <div class="photo-theme site-theme">

    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <section class="site-hero" aria-labelledby="page-title">
        <Image class="site-hero-image" src={hero} alt="Model in a white Flowin polo with pipes and fittings in a light-blue showroom" widths={[640, 960, 1440, 1774]} sizes="100vw" format="webp" width={1774} height={887} fetchpriority="high" loading="eager" />
        <div class="site-hero-content theme-wrap"><p class="audience-line">For dealers and plumbers across India</p><h1 id="page-title">One brand for plumbing, drainage and agriculture.</h1><p>Bring more of your piping needs together with Flowin. Explore uPVC, cPVC, SWR and agriculture pipes and fittings, manufactured by Flowin Pipe Pvt. Ltd. since 2013.</p><div class="hero-actions"><a class="theme-button" href="#products">Explore Flowin products</a><a class="theme-button secondary" href={catalogue} target="_blank" rel="noopener">Open the catalogue</a></div></div>
      </section>

      {<nav class="application-pills theme-wrap" aria-label="Browse by application"><a href="/products/upvc/">uPVC plumbing</a><a href="/products/cpvc/">cPVC plumbing</a><a href="/products/swr/">SWR drainage</a><a href="/products/agriculture/">Agriculture</a></nav>}

      <section class="theme-ranges theme-wrap" id="products" aria-labelledby="ranges-title">
        <div class="theme-section-head"><div><p class="section-note">The Flowin range</p><h2 id="ranges-title">A Flowin range for the work you do.</h2></div><p>From plumbing supplies to drainage and agricultural piping, find the products for your next customer enquiry or project.</p></div>
        <div class="photo-range-grid">{ranges.map(range => <a class="photo-range" href={range.href}><figure><img src={range.photo} alt={range.caption === 'Flowin product photo' ? `${range.name} fitting from the Flowin range` : range.caption} width="600" height="400" loading="lazy" /></figure><div class="photo-range-copy"><h3>{range.name}</h3><p class="range-summary">{range.body}</p><span class="range-action">Explore range <span aria-hidden="true">↗</span></span></div></a>)}</div>
      </section>

      <section class="selection-section" aria-labelledby="selection-title"><div class="theme-wrap selection-inner"><figure><img src="/images/plumbing-sergei-starostin.jpg" alt="A plumber working on a pipe connection" width="1400" height="933" loading="lazy" /></figure><div><p class="section-note">From selection to your next order</p><h2 id="selection-title">Bring the right details<br />to the next order.</h2><ol><li><strong>Choose the range</strong><p>Choose uPVC, cPVC, SWR or agriculture for the system specified for the job.</p></li><li><strong>Check the family and size</strong><p>Find the pipe length or fitting variant you need, then check the size.</p></li><li><strong>Build your order list</strong><p>Put products, sizes and quantities together so your dealer knows what you need.</p></li></ol><a class="quiet-link" href="/applications/">Browse by application</a></div></div></section>

      <section class="theme-about theme-wrap" aria-labelledby="about-title"><div><p class="section-note">About Flowin</p><h2 id="about-title">Manufactured by Flowin.<br />Since 2013.</h2></div><div><p>Modern manufacturing practices and stringent quality control support our commitment to quality, durability and consistent performance. Get to know the company behind the Flowin range.</p><a class="quiet-link" href="/about/">Read about Flowin</a></div></section>

      <section class="theme-final" id="contact" aria-labelledby="final-title"><div class="theme-wrap"><div><h2 id="final-title">Make Flowin part of your next order.</h2><p>Found the products you need? Put your sizes and quantities into one list, ready to share with your dealer.</p></div><a class="theme-button" href="/enquiry/">Build your order list</a></div></section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
