---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import RangeCard from '../components/RangeCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Flowin Pipes & Fittings | Piping solutions for every need" description="Explore Flowin uPVC, cPVC, SWR drainage and agriculture pipes and fittings. Download the 2026 product catalogue.">
  <SiteHeader />
  <main>
    <section class="wrap hero-copy" aria-labelledby="hero-title">
      <span class="eyebrow">Pipes &amp; fittings</span>
      <div class="hero-heading">
        <h1 id="hero-title">Built for every<br />flow of life.</h1>
        <div class="hero-heading-side">
          <p>Explore piping solutions for plumbing, drainage and agriculture, brought together in one catalogue.</p>
          <a href="#products" class="text-link">Explore our products <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <figure class="wrap hero-visual">
      <img src="/images/flowin-warehouse-concept.png" alt="Illustrative scene of pipes in an industrial warehouse" width="1536" height="1024" fetchpriority="high" />
      <figcaption><span>01 / PRODUCT SYSTEMS</span><span>Illustrative imagery</span></figcaption>
    </figure>

    <section class="wrap intro" id="about" aria-labelledby="about-title">
      <div><span class="eyebrow">About Flowin</span><h2 id="about-title">The right solution, from source to site.</h2></div>
      <div class="intro-detail"><p>Flowin's catalogue brings together pipes and fittings for plumbing, drainage and agricultural applications.</p><p>Browse the ranges, compare sizes and configurations, and use the latest price list to find the right product family.</p></div>
    </section>

    <section class="wrap products" id="products" aria-labelledby="products-title">
      <div class="section-top"><span class="eyebrow">Our product ranges</span><h2 id="products-title">Piping solutions for<br />every application.</h2><p>Four product systems across plumbing, drainage and agriculture.</p></div>
      <div class="range-grid">
        <RangeCard number="01" icon="upvc" title="uPVC plumbing" description="Pipes and fittings across schedules, sizes and configurations." href="/products/upvc/" />
        <RangeCard number="02" icon="cpvc" title="cPVC plumbing" description="Pipes and fittings in SDR and schedule-based variants." featured />
        <RangeCard number="03" icon="swr" title="SWR drainage" description="Ring-fit and self-fit pipes and fittings." />
        <RangeCard number="04" icon="agriculture" title="Agriculture" description="Pipes and fittings for agricultural applications." />
      </div>
      <p class="range-note">Detailed product families and specification tables are being prepared. <a href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">Browse the complete 2026 catalogue ↗</a></p>
    </section>

    <section class="dark-section" id="applications" aria-labelledby="applications-title">
      <div class="wrap">
        <div class="dark-header"><span class="eyebrow">Where it works</span><h2 id="applications-title">A system for the<br />work behind the world.</h2><p>Find product ranges for plumbing, drainage and agricultural applications.</p></div>
        <div class="dark-feature">
          <div class="dark-feature-photo" role="img" aria-label="Illustrative scene of a pipe warehouse"></div>
          <div class="dark-feature-copy"><span class="index">01 / COMPLETE PRODUCT RANGE</span><h3>From the first connection to the final run.</h3><p>Find the sizes, variants, packing details and printed rates in the latest Flowin catalogue.</p><a class="text-link" href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">View the 2026 catalogue <span aria-hidden="true">↗</span></a></div>
        </div>
      </div>
    </section>

    <section class="wrap catalogue-callout" id="contact" aria-labelledby="contact-title">
      <div><span class="eyebrow">Get in touch</span><h2 id="contact-title">Let's find the right fit for your project.</h2></div>
      <div class="catalogue-aside"><p>Email and phone details will be added here once confirmed. In the meantime, explore the complete product and price catalogue.</p><a class="solid-btn" href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">Download catalogue <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
