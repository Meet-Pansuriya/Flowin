---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import RangeCard from './RangeCard.astro';
import SiteFooter from './SiteFooter.astro';
import ThemeSelector from './ThemeSelector.astro';
---

<BaseLayout title="Flowin Pipes & Fittings | Product ranges for plumbers & dealers" description="Explore Flowin uPVC, cPVC, SWR drainage and agriculture pipes and fittings. Download the 2026 product catalogue.">
  <ThemeSelector active="original" />
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <section class="wrap hero-copy" aria-labelledby="hero-title">
      <span class="eyebrow">Pipes &amp; fittings</span>
      <div class="hero-heading">
        <h1 id="hero-title">Pipes and fittings.<br />Ready for your next requirement.</h1>
        <div class="hero-heading-side">
          <p>Find your range, compare sizes and packing, then check the printed rates in the 2026 catalogue.</p>
          <a href="#products" class="text-link">Browse product ranges <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <figure class="wrap hero-visual">
      <img src="/images/plumbing-sergei-starostin.jpg" alt="A plumber working on a pipe connection, generic application photograph" width="1536" height="1024" fetchpriority="high" />
      <figcaption><span>From the counter to the site</span><span>Application photo · Sergei Starostin / Pexels</span></figcaption>
    </figure>

    <section class="wrap intro" id="about" aria-labelledby="about-title">
      <div><span class="eyebrow">About Flowin</span><h2 id="about-title">One catalogue for the next customer enquiry.</h2></div>
      <div class="intro-detail"><p>Established in 2013, Flowin Pipe Pvt. Ltd. makes pipes and fittings for plumbing, drainage and agricultural applications.</p><div><p>Find the family and size your customer needs. Keep the catalogue handy for packing and printed rates.</p><a class="text-link intro-link" href="/about/">Read about Flowin <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="wrap products" id="products" aria-labelledby="products-title">
      <div class="section-top"><span class="eyebrow">Our product ranges</span><h2 id="products-title">Choose the range.<br />Check the details.</h2><p>Four product systems across plumbing, drainage and agriculture.</p></div>
      <div class="range-grid">
        <RangeCard number="01" icon="upvc" title="uPVC plumbing" description="Pipes and fittings across schedules, sizes and configurations." href="/products/upvc/" />
        <RangeCard number="02" icon="cpvc" title="cPVC plumbing" description="Pipes and fittings in SDR and schedule-based variants." href="/products/cpvc/" featured />
        <RangeCard number="03" icon="swr" title="SWR drainage" description="Ring-fit and self-fit pipes and fittings." href="/products/swr/" />
        <RangeCard number="04" icon="agriculture" title="Agriculture" description="Pipes and fittings for agricultural applications." href="/products/agriculture/" />
      </div>
      <p class="range-note">Explore verified product families, or <a href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">browse the complete 2026 catalogue ↗</a></p>
    </section>

    <section class="dark-section" id="applications" aria-labelledby="applications-title">
      <div class="wrap">
        <div class="dark-header"><span class="eyebrow">Where it works</span><h2 id="applications-title">Start with the<br />work at hand.</h2><p>Browse by application, then compare the relevant product systems.</p></div>
        <div class="dark-feature">
          <div class="dark-feature-photo"><img src="/images/irrigation-daniel-kawed.jpg" alt="Workers fixing irrigation piping in a banana plantation" width="1400" height="933" loading="lazy" /><small>Application photo · daniel kawed / Unsplash</small></div>
          <div class="dark-feature-copy"><span class="index">01 / APPLICATIONS</span><h3>Plumbing, drainage and agriculture.</h3><p>See which catalogue range to explore for the work you are planning, then check the detailed variants and sizes.</p><a class="text-link" href="/applications/">Explore applications <span aria-hidden="true">↗</span></a></div>
        </div>
      </div>
    </section>

    <section class="wrap catalogue-callout" id="contact" aria-labelledby="contact-title">
      <div><span class="eyebrow">Get in touch</span><h2 id="contact-title">Keep the next requirement clear.</h2></div>
      <div class="catalogue-aside"><p>Note the product family, size and quantity for your enquiry. Check packing and printed rates against the official 2026 catalogue.</p><a class="solid-btn" href="/catalogue/flowin-price-list-2026.pdf" target="_blank" rel="noopener">Download catalogue <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <SiteFooter />
<style>
.dark-feature-photo{background:none}.dark-feature-photo img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.dark-feature-photo small{position:absolute;bottom:12px;left:16px;z-index:2;color:white;background:#17243dcc;padding:5px 8px;font-size:10px}
</style>
</BaseLayout>
