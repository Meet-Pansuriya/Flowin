---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import RateTable from './RateTable.astro';
import type { ProductVariant } from '../data/productFamilies';

interface Props {
  rangeName: string;
  rangeSlug: string;
  catalogueSection: string;
  familyName: string;
  lead: string;
  description: string;
  imageSrc?: string;
  imageAlt?: string;
  variants: ProductVariant[];
  sourcePage: number;
  additionalSourcePage?: number;
}

const { rangeName, rangeSlug, catalogueSection, familyName, lead, description, imageSrc, imageAlt, variants, sourcePage, additionalSourcePage } = Astro.props;
const catalogueUrl = `/catalogue/flowin-price-list-2026.pdf#page=${sourcePage}`;
const additionalCatalogueUrl = additionalSourcePage ? `/catalogue/flowin-price-list-2026.pdf#page=${additionalSourcePage}` : undefined;
---

<BaseLayout title={`${rangeName} ${familyName} | Flowin Pipes & Fittings`} description={description}>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/products/${rangeSlug}/`}>{rangeName} plumbing</a><span aria-hidden="true">/</span><span aria-current="page">{familyName}</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title">
      <div class="product-hero-copy">
        <span class="eyebrow">{rangeName} plumbing / fittings</span>
        <h1 id="family-title">{rangeName}<br />{familyName.toLowerCase()}.</h1>
        <p class="product-lead">{lead}</p>
        <p class="product-standard">Product specification: <strong>{catalogueSection}</strong></p>
        <div class="product-actions"><a class="request-link" href={`/enquiry/?range=${rangeSlug}&family=${encodeURIComponent(familyName)}`}>Build your order list</a><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">View catalogue <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="product-visual">{imageSrc ? <img src={imageSrc} alt={imageAlt ?? ''} width="300" height="300" /> : <img src="/images/flowin-product-group-legacy.jpg" alt="Flowin pipes and fittings assortment" width="500" height="500" />}</figure>
    </section>

    <nav class="wrap table-jump" aria-label={`${familyName} tables`}>
      <span class="table-jump-label">Jump to a table</span>
      {variants.map((variant) => <a href={`#${variant.id}`}>{variant.name}<span aria-hidden="true"> ↘</span></a>)}
    </nav>

    <section class="product-data" id="sizes" aria-labelledby="sizes-title">
      <div class="wrap">
        <div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">Choose your size.<br />Plan your order.</h2><p>Find the fitting size you need, check packing and plan your order quantity.</p></div>
        <div class="variant-grid">
          {variants.map((variant, index) => <RateTable variant={variant} number={String(index + 1).padStart(2, '0')} sourcePage={sourcePage} />)}
        </div>
        <div class="source-band"><div><a href={catalogueUrl} target="_blank" rel="noopener">View catalogue ↗</a>{additionalCatalogueUrl && <a href={additionalCatalogueUrl} target="_blank" rel="noopener">More catalogue details ↗</a>}</div></div>
      </div>
    </section>

    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Complete your product list</span><h2 id="family-outro-title">Need another fitting?</h2></div><div><p>Bring the rest of your {rangeName} pipes and fittings into one Flowin order. Explore the range and add the products your list needs.</p><a class="solid-btn" href={`/products/${rangeSlug}/`}>Explore {rangeName} range <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
