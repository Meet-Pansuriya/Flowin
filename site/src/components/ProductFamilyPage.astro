---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import RateTable from './RateTable.astro';
import type { ProductVariant } from '../data/productFamilies';

interface Props {
  rangeName: string;
  rangeSlug: string;
  catalogueSection: string;
  familyName: string;
  lead: string;
  description: string;
  imageSrc?: string;
  imageAlt?: string;
  variants: ProductVariant[];
  sourcePage: number;
  additionalSourcePage?: number;
}

const { rangeName, rangeSlug, catalogueSection, familyName, lead, description, imageSrc, imageAlt, variants, sourcePage, additionalSourcePage } = Astro.props;
const catalogueUrl = `/catalogue/flowin-price-list-2026.pdf#page=${sourcePage}`;
const additionalCatalogueUrl = additionalSourcePage ? `/catalogue/flowin-price-list-2026.pdf#page=${additionalSourcePage}` : undefined;
---

<BaseLayout title={`${rangeName} ${familyName} | Flowin Pipes & Fittings`} description={description}>
  <SiteHeader />
  <main>
    <div class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/products/${rangeSlug}/`}>{rangeName} plumbing</a><span aria-hidden="true">/</span><span aria-current="page">{familyName}</span></div>
    <section class="wrap product-hero" aria-labelledby="family-title">
      <div class="product-hero-copy">
        <span class="eyebrow">{rangeName} plumbing / fittings</span>
        <h1 id="family-title">{rangeName}<br />{familyName.toLowerCase()}.</h1>
        <p class="product-lead">{lead}</p>
        <p class="product-standard">Catalogue section: <strong>{catalogueSection}</strong></p>
        <div class="product-actions"><a class="solid-btn" href="#sizes">View sizes &amp; rates <span aria-hidden="true">↓</span></a><a class="text-link" href={catalogueUrl} target="_blank" rel="noopener">See catalogue page {sourcePage} <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="product-visual">{imageSrc ? <img src={imageSrc} alt={imageAlt ?? ''} width="300" height="300" /> : <svg viewBox="0 0 500 500" role="img" aria-label="Illustrative line diagram of plumbing fittings"><path d="M80 90h100v100h75v105h-75v115H80V295H20V190h60zM320 80h95v110h45v105h-45v115h-95V295h-45V190h45z" fill="#d9ddd7" stroke="#818982" stroke-width="4"/><ellipse cx="130" cy="90" rx="50" ry="15" fill="#c9d0c8" stroke="#818982" stroke-width="3"/><ellipse cx="367" cy="80" rx="48" ry="14" fill="#c9d0c8" stroke="#818982" stroke-width="3"/><path d="M20 245h60M180 245h75M275 245h45M415 245h45" stroke="#c64d18" stroke-width="5"/></svg>}<figcaption>{imageSrc ? "Product image from Flowin's earlier website." : 'Illustrative fitting diagram; not product photography.'}</figcaption></figure>
    </section>

    <section class="product-data" id="sizes" aria-labelledby="sizes-title">
      <div class="wrap">
        <div class="product-data-intro"><span class="eyebrow">Catalogue details</span><h2 id="sizes-title">The sizes behind<br />the system.</h2><p>Rates are per piece as listed in the supplied 2026 price list. The original catalogue remains the definitive reference.</p></div>
        <div class="variant-grid">
          {variants.map((variant, index) => <RateTable variant={variant} number={String(index + 1).padStart(2, '0')} sourcePage={sourcePage} />)}
        </div>
        <div class="source-band"><p>Source: Flowin Price list 2026, PDF page {sourcePage}{additionalSourcePage && ` and ${additionalSourcePage}`}. No currency symbol is added because the supplied table does not specify one.</p><div><a href={catalogueUrl} target="_blank" rel="noopener">Open page {sourcePage} ↗</a>{additionalCatalogueUrl && <a href={additionalCatalogueUrl} target="_blank" rel="noopener">Open page {additionalSourcePage} ↗</a>}</div></div>
      </div>
    </section>

    <section class="wrap family-outro" aria-labelledby="family-outro-title"><div><span class="eyebrow">Next connection</span><h2 id="family-outro-title">Need another fitting?</h2></div><div><p>Browse the {rangeName} range for other live family pages, or use the full catalogue for products not yet on this site. Email and phone details will be added when confirmed.</p><a class="solid-btn" href={`/products/${rangeSlug}/`}>Explore {rangeName} range <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
