---
import { siteRanges } from '../data/siteRanges';
import ProductTextVisual from './ProductTextVisual.astro';
import { catalogueProducts } from '../data/octoberCatalogue';
import { matchesCollection } from '../data/octoberCatalogue';
interface Props { range?: string; system?: string; collection?: string; }
const { range, system, collection } = Astro.props;
const families = siteRanges.filter(r => !range || r.slug === range).flatMap(r => [...r.families]).filter(f => (!system || f.system === system) && matchesCollection(f, collection));
const groups = [...new Set(families.map(f => `${f.range}:${f.system}:${f.kind}`))].map(key => {
  const items = families.filter(f => `${f.range}:${f.system}:${f.kind}` === key);
  const first = items[0];
  const systemLabel = first.system === 'ring-fit' ? 'Ring-fit' : first.system === 'self-fit' ? 'Self-fit' : '';
  return { key, items, label: `${!range ? siteRanges.find(r => r.slug === first.range)?.name + ' ' : ''}${!system ? systemLabel + ' ' : ''}${first.kind === 'pipes' ? 'Pipes' : 'Fittings & accessories'}`.trim() };
});
---
<section class="directory" aria-label="Products">
 <div class="directory-tools"><label class="search-field">Find a product<input type="search" placeholder="Try pipes, elbows or ring-fit" data-family-search /></label>{!range && <label class="range-filter">Product range<select data-range-filter><option value="">All ranges</option>{siteRanges.map(r => <option value={r.slug}>{r.name}</option>)}</select></label>}<p class="directory-status" aria-live="polite" data-directory-status>{families.length} products</p></div>
 {groups.map(group => <section class="catalogue-directory-group" data-directory-group><h3 class="catalogue-group-title">{group.label}</h3><div class="directory-grid">{group.items.map(f => <a class:list={['directory-card', {'directory-card-text': catalogueProducts.find(p => p.href === f.href)?.imageType === 'catalogue-table'}]} href={f.href} data-family-card data-range={f.range} data-search={`${f.title} ${f.description} ${f.range}`.toLowerCase()}>{catalogueProducts.find(p => p.href === f.href)?.imageType === 'catalogue-table' ? <ProductTextVisual product={catalogueProducts.find(p => p.href === f.href)} compact /> : <figure><img src={f.image} alt={f.caption} width="400" height="300" loading="lazy" /></figure>}<div><span class="directory-range">{siteRanges.find(r => r.slug === f.range)?.name}</span><h4>{f.title}</h4><p>{f.description}</p><span class="directory-link">View sizes &amp; packing <span aria-hidden="true">↗</span></span></div></a>)}</div></section>)}
 <p class="directory-empty" data-directory-empty hidden>No matching products. Try a shorter name or another range.</p>
</section>
<script>
 document.querySelectorAll<HTMLElement>('.directory').forEach(root => {
  const input = root.querySelector<HTMLInputElement>('[data-family-search]'); const select = root.querySelector<HTMLSelectElement>('[data-range-filter]'); const cards = [...root.querySelectorAll<HTMLElement>('[data-family-card]')];
  const update = () => { const terms = (input?.value.toLowerCase().trim() ?? '').split(/\s+/).filter(Boolean); let count = 0; cards.forEach(card => {const show = (!select?.value || card.dataset.range === select.value) && terms.every(t => card.dataset.search?.includes(t)); card.hidden = !show; if(show) count++;}); root.querySelectorAll<HTMLElement>('[data-directory-group]').forEach(group => {group.hidden = !group.querySelector('[data-family-card]:not([hidden])');}); const status=root.querySelector('[data-directory-status]'); if(status) status.textContent=`${count} ${count===1?'product':'products'}`; const empty=root.querySelector<HTMLElement>('[data-directory-empty]'); if(empty) empty.hidden=count>0; };
  input?.addEventListener('input',update); select?.addEventListener('change',update);
 });
</script>
