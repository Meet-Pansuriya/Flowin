---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import FamilyDirectory from './FamilyDirectory.astro';
import { siteRanges } from '../data/siteRanges';
const { slug } = Astro.props;
const range = siteRanges.find(r => r.slug === slug)!;
const descriptions: Record<string, string> = {
 upvc: 'Explore Flowin uPVC plumbing pipes and fittings. Compare SCH-40 and SCH-80 pipes, elbows, tees and couplers by size and packing. Prepare your order list.',
 cpvc: 'Explore Flowin cPVC plumbing pipes and fittings. Find SDR and schedule pipes, elbows, tees and couplers, compare sizes and prepare your order list.',
 swr: 'Explore Flowin SWR drainage pipes and fittings. Browse Ring-fit and Self-fit systems separately, compare sizes and prepare your product requirement.',
 agriculture: 'Explore Flowin agricultural pipes and fittings. Compare lengths, sizes and pressure groups, then prepare your dealer enquiry with the quantities you need.',
};
---
<BaseLayout title={`${range.name} Pipes & Fittings | Sizes & Catalogue | Flowin`} description={descriptions[slug]}>
 <SiteHeader /><main id="main-content" tabindex="-1"><nav class="wrap product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><span aria-current="page">{range.name}</span></nav>
 <section class="wrap inside-hero"><div><p class="kicker">Flowin product range</p><h1>{range.name}</h1><p class="inside-lead">{range.lead}</p><div class="product-actions"><a class="solid-btn" href="#families">Explore products</a><a class="text-link" href={`/catalogue/flowin-price-list-october-2026.pdf#page=${range.sourcePage}`} target="_blank" rel="noopener">Open catalogue section</a></div></div><figure><img src={range.image} alt={range.caption} width="900" height="600" fetchpriority="high" /></figure></section>
 <section class="wrap directory-section" id="families"><div class="section-heading"><div><p class="kicker">Browse {range.name}</p><h2>Choose the products for your order.</h2></div><p>Find the product family your customer or project calls for. Choose the size and check packing before putting your quantity on the list.</p></div>{slug === 'swr' ? <div class="swr-systems">{['ring-fit', 'self-fit'].map(system => <section id={system} class="swr-system" aria-labelledby={`${system}-title`}><h3 id={`${system}-title`}>{system === 'ring-fit' ? 'SWR Ring-fit' : 'SWR Self-fit'}</h3><FamilyDirectory range={slug} system={system} /></section>)}</div> : <FamilyDirectory range={slug} />}</section>
 <section class="catalogue-banner"><div class="wrap"><div><h2>Put the Flowin range to work.</h2><p>Keep the complete range at your counter or on site. Download the 2026 catalogue and plan your next Flowin order.</p></div><a class="solid-btn" href="/catalogue/">Explore the 2026 catalogue</a></div></section></main><SiteFooter />
</BaseLayout>
