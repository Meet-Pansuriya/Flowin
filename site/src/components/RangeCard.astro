---
import RangeIllustration from './RangeIllustration.astro';
interface Props {
  number: string;
  title: string;
  description: string;
  icon: 'upvc' | 'cpvc' | 'swr' | 'agriculture';
  featured?: boolean;
  href: string;
}

const { number, title, description, icon, featured = false, href } = Astro.props;
---

<a class:list={['range-card', { featured }]} href={href} aria-label={`Explore ${title} range`}>
  <span class="number">{number}.</span>
  <div class="symbol" aria-hidden="true"><RangeIllustration kind={icon} /></div>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="range-card-link" aria-hidden="true">Explore range <span aria-hidden="true">↗</span></span>
</a>
