---
const photos = { upvc: '/images/upvc-elbow-legacy.jpg', cpvc: '/images/cpvc-elbow-legacy.jpg', swr: '/images/plumbing-sergei-starostin.jpg', agriculture: '/images/irrigation-daniel-kawed.jpg' };
interface Props {
  number: string;
  title: string;
  description: string;
  icon: 'upvc' | 'cpvc' | 'swr' | 'agriculture';
  featured?: boolean;
  href: string;
}

const { number, title, description, icon, featured = false, href } = Astro.props;
---

<a class:list={['range-card', { featured }]} href={href} aria-label={`Explore ${title} range`}>
  <span class="number">{number}.</span>
  <div class="symbol" aria-hidden="true"><img src={photos[icon]} alt="" width="300" height="300" loading="lazy" /></div>
  <small class="photo-kind">{icon === 'swr' || icon === 'agriculture' ? 'Application photo' : 'Flowin product photo'}</small>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="range-card-link" aria-hidden="true">Explore range <span aria-hidden="true">↗</span></span>
</a>

<style>.range-card .symbol{width:100%;height:145px;margin:18px 0}.symbol img{width:100%;height:100%;object-fit:cover}.photo-kind{font-size:9px;margin-bottom:10px;opacity:.8}</style>
